{
  "expo": {
    "name": "DeinStammtisch",
    "slug": "stammtisch-app",
    "scheme": "stammtisch-app",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diehellen.stammtischapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.diehellen.stammtischapp",
      "adaptiveIcon": {
        "backgroundColor": "#F8E8D0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "DeinStammtisch braucht Zugriff auf deine Fotos, damit du ein Profilbild, ein Foto zum Termin oder das Logo eures Stammtischs auswählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EEE6"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5470a5d-eb6b-47c1-96ef-890a746cd26d"
      }
    },
    "owner": "joshmb"
  }
}
